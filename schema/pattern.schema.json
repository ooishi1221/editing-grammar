{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ooishi1221/editing-grammar/schema/pattern.schema.json",
  "title": "Editing Grammar Pattern",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "category", "purpose", "goodFor", "avoidWhen", "tags", "evidence"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "category": { "enum": ["captions", "reactions", "information", "layout", "transitions", "audio", "game_ui", "branding", "retention", "shorts"] },
    "purpose": { "$ref": "#/$defs/nonEmptyStringList" },
    "description": { "type": "string", "minLength": 1 },
    "goodFor": { "$ref": "#/$defs/stringList" },
    "avoidWhen": { "$ref": "#/$defs/stringList" },
    "tags": { "$ref": "#/$defs/stringList" },
    "retrievalTerms": { "$ref": "#/$defs/retrievalTerms" },
    "visual": { "$ref": "#/$defs/visual" },
    "audio": { "$ref": "#/$defs/audio" },
    "timing": { "$ref": "#/$defs/timing" },
    "implementation": { "$ref": "#/$defs/implementation" },
    "requirements": { "$ref": "#/$defs/stringList" },
    "failureModes": { "$ref": "#/$defs/stringList" },
    "relatedPatterns": { "$ref": "#/$defs/stringList" },
    "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }
  },
  "$defs": {
    "stringList": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "retrievalTerms": { "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "nonEmptyStringList": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "scopeList": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*(\\.[A-Za-z][A-Za-z0-9]*)*$" } },
    "scalar": { "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }] },
    "frameRange": { "type": "array", "minItems": 2, "prefixItems": [{ "type": "integer", "minimum": 1 }, { "type": "integer", "minimum": 1 }], "items": false },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "confidence", "scope"],
      "properties": {
        "type": { "enum": ["observed", "inferred", "proposal"] },
        "source": { "$ref": "#/$defs/sourceMetadata" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "scope": { "$ref": "#/$defs/scopeList" }
      },
      "allOf": [{ "if": { "properties": { "type": { "const": "observed" } } }, "then": { "properties": { "source": true }, "required": ["source"] } }]
    },
    "sourceMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "location"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "location": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "classification": { "type": "string", "minLength": 1 }
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "palette": { "$ref": "#/$defs/stringList" },
        "typography": { "type": "object", "additionalProperties": false, "properties": { "style": { "type": "string" }, "weight": { "type": "string" }, "case": { "type": "string" }, "alignment": { "type": "string" } } },
        "layout": { "type": "object", "additionalProperties": false, "properties": { "type": { "type": "string" }, "position": { "type": "string" }, "safeArea": { "type": "string" } } },
        "motion": { "type": "object", "additionalProperties": false, "properties": { "type": { "type": "string" }, "trigger": { "type": "string" }, "durationFrames": { "$ref": "#/$defs/frameRange" }, "easing": { "type": "string" }, "parameters": { "type": "object", "additionalProperties": { "$ref": "#/$defs/scalar" } } } },
        "transition": { "type": "object", "additionalProperties": false, "properties": { "type": { "type": "string" }, "direction": { "type": "string" }, "durationFrames": { "$ref": "#/$defs/frameRange" } } }
      }
    },
    "audio": { "type": "object", "additionalProperties": false, "properties": { "type": { "type": "string" }, "cue": { "type": "string" }, "sync": { "type": "string" }, "optional": { "type": "boolean" }, "notes": { "type": "string" } } },
    "timing": { "type": "object", "additionalProperties": false, "properties": { "trigger": { "type": "string" }, "duration": { "type": "string" }, "beatRelation": { "type": "string" } } },
    "implementationParameterValueType": { "enum": ["string", "number", "boolean", "object", "array"] },
    "runtimeInputParameterDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description", "required", "valueType"],
      "properties": {
        "kind": { "const": "runtime-input" },
        "description": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "valueType": { "$ref": "#/$defs/implementationParameterValueType" }
      }
    },
    "contextParameterDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description", "required", "valueType"],
      "properties": {
        "kind": { "const": "context" },
        "description": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "valueType": { "$ref": "#/$defs/implementationParameterValueType" }
      }
    },
    "constantParameterDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description", "required", "valueType", "value"],
      "properties": {
        "kind": { "const": "constant" },
        "description": { "type": "string", "minLength": 1 },
        "required": { "const": false },
        "valueType": { "$ref": "#/$defs/implementationParameterValueType" },
        "value": {}
      },
      "allOf": [
        { "if": { "properties": { "valueType": { "const": "string" } } }, "then": { "properties": { "value": { "type": "string" } } } },
        { "if": { "properties": { "valueType": { "const": "number" } } }, "then": { "properties": { "value": { "type": "number" } } } },
        { "if": { "properties": { "valueType": { "const": "boolean" } } }, "then": { "properties": { "value": { "type": "boolean" } } } },
        { "if": { "properties": { "valueType": { "const": "object" } } }, "then": { "properties": { "value": { "type": "object" } } } },
        { "if": { "properties": { "valueType": { "const": "array" } } }, "then": { "properties": { "value": { "type": "array" } } } }
      ]
    },
    "implementationParameterDeclaration": {
      "oneOf": [
        { "$ref": "#/$defs/runtimeInputParameterDeclaration" },
        { "$ref": "#/$defs/contextParameterDeclaration" },
        { "$ref": "#/$defs/constantParameterDeclaration" }
      ]
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deterministic": { "type": "boolean" },
        "recipe": { "$ref": "#/$defs/stringList" },
        "rendererCandidates": { "$ref": "#/$defs/stringList" },
        "parameters": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/implementationParameterDeclaration" }
        }
      }
    }
  }
}
